# ── Helpers ──────────────────────────────────────────────────────────────


def _is_wsl() -> bool:
    try:
        with open("/proc/version", "r") as f:
            return "microsoft" in f.read().lower()
    except (FileNotFoundError, PermissionError):
        return False


def clear_screen() -> None:
    if IS_WINDOWS:
        os.system("cls")
    else:
        sys.stdout.write("\033[2J\033[H")
        sys.stdout.flush()


def term_width() -> int:
    try:
        return os.get_terminal_size().columns
    except OSError:
        return 80


def is_compact() -> bool:
    return term_width() < 100


def strip_ansi(s: str) -> str:
    return ANSI_RE.sub("", s)


def _wrap_header(parts: list[str], max_width: int, indent: str = "  ") -> list[str]:
    lines: list[str] = []
    current = ""
    for part in parts:
        candidate = f"{current} {part}".strip() if current else part
        if len(strip_ansi(candidate)) > max_width and current:
            lines.append(indent + current)
            current = part
        else:
            current = candidate
    if current:
        lines.append(indent + current)
    return lines


def _is_system_text(text: str) -> bool:
    if not text:
        return True
    for tag in SYSTEM_TAGS:
        if tag in text:
            return True
    return False


def _fzf_version() -> float:
    try:
        out = subprocess.check_output(["fzf", "--version"], encoding="utf-8", errors="replace")
        m = re.match(r"(\d+\.\d+)", out.strip())
        return float(m.group(1)) if m else 0.0
    except Exception:
        return 0.0


