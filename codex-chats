# ── Session parsing ───────────────────────────────────────────────────────


def _session_id_from_path(path: Path) -> str | None:
    m = SESSION_ID_RE.search(path.stem)
    return m.group(1) if m else None


def _parse_session_meta(path: Path):
    try:
        with path.open("r", errors="replace") as f:
            for line in f:
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if obj.get("type") == "session_meta":
                    payload = obj.get("payload", {})
                    ts = payload.get("timestamp")
                    return {
                        "id": payload.get("id") or _session_id_from_path(path),
                        "cwd": payload.get("cwd", ""),
                        "timestamp": ts,
                    }
    except OSError:
        return None
    return None


def _extract_text(content) -> str:
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        parts = []
        for part in content:
            if isinstance(part, dict):
                if part.get("type") in ("input_text", "output_text", "text"):
                    parts.append(part.get("text", ""))
        return "".join(parts)
    return ""


def _format_date(ts: str | None) -> str:
    if not ts:
        return ""
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.strftime("%m/%d/%y").lstrip("0").replace("/0", "/")
    except Exception:
        return ts[:16]


def _session_size(path: Path) -> str:
    size = path.stat().st_size
    if size < 1024:
        return f"{size}B"
    if size < 1024 * 1024:
        return f"{size // 1024}K"
    return f"{size // (1024 * 1024)}M"


def _display_path(path: str) -> str:
    if not path:
        return ""
    home = str(Path.home())
    if path == home:
        return "~"
    if path.startswith(home + os.sep):
        return "~/" + path[len(home) + 1 :]
    return path


def parse_one_chat(path: Path) -> dict | None:
    try:
        stat = path.stat()
    except OSError:
        return None
    size = stat.st_size
    mtime = stat.st_mtime
    meta = _parse_session_meta(path)
    session_id = (meta or {}).get("id") or _session_id_from_path(path) or ""
    timestamp = (meta or {}).get("timestamp") or ""

    first_user_msg = ""
    has_assistant = False
    bytes_read = 0

    try:
        with path.open("r", errors="replace") as f:
            for line in f:
                bytes_read += len(line)
                if bytes_read > 200000:
                    break
                try:
                    obj = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if obj.get("type") != "response_item":
                    continue
                payload = obj.get("payload", {})
                if payload.get("type") != "message":
                    continue
                role = payload.get("role")
                content = payload.get("content", [])
                text = _extract_text(content).strip()
                if role == "assistant" and text:
                    has_assistant = True
                if role == "user" and not first_user_msg:
                    if text and not _is_system_text(text):
                        first_user_msg = text.replace("\n", " ").strip()
                        break
    except OSError:
        pass

    if first_user_msg and len(first_user_msg) > 120:
        first_user_msg = first_user_msg[:117] + "..."

    truly_empty = False
    if not first_user_msg:
        first_user_msg = "(resumed session)" if has_assistant else "(empty session)"
        truly_empty = not has_assistant

    date_str = _format_date(timestamp)

    if size < 1024:
        size_str = f"{size}B"
    elif size < 1024 * 1024:
        size_str = f"{size // 1024}K"
    else:
        size_str = f"{size // (1024 * 1024)}M"

    return {
        "file": str(path),
        "date": date_str,
        "size": size_str,
        "message": first_user_msg,
        "truly_empty": truly_empty,
        "timestamp": timestamp or "0",
        "mtime": mtime,
        "session_id": session_id,
    }


def list_projects():
    projects = {}
    newest = {}
    for path in SESSION_ROOT.rglob("rollout-*.jsonl"):
        meta = _parse_session_meta(path)
        if not meta:
            continue
        cwd = meta.get("cwd") or str(Path.home())
        projects[cwd] = projects.get(cwd, 0) + 1
        ts = meta.get("timestamp") or ""
        newest[cwd] = max(newest.get(cwd, ""), ts)
    items = []
    for cwd, count in projects.items():
        missing = not os.path.isdir(cwd)
        display = _display_path(cwd)
        items.append((display, cwd, count, newest.get(cwd, ""), missing))
    return items


def sort_projects(items, mode):
    if mode == "name":
        return sorted(items, key=lambda p: p[0].lower())
    if mode == "chats":
        return sorted(items, key=lambda p: (-p[2], p[0].lower()))
    if mode == "recent":
        return sorted(items, key=lambda p: p[3], reverse=True)
    return items


def fmt_project_line(name, count, max_name_len, missing=False):
    display_name = name
    if is_compact():
        max_name = term_width() - 16
        display_name = name[: max_name - 1] + "~" if len(name) > max_name else name
        padding = min(max_name, max_name_len) - len(display_name) + 2
    else:
        padding = max_name_len - len(name) + 2
    if missing:
        return f"  {MAGENTA}{display_name}{' ' * padding}{count:>3d} chats{RESET}"
    if count == 0:
        return f"  {DIM}{display_name}{' ' * padding}  0 chats{RESET}"
    count_color = GREEN if count < 10 else YELLOW if count < 30 else RED
    return f"  {BOLD}\033[37m{display_name}{RESET}{' ' * padding}{count_color}{count:>3d}{RESET} {DIM}chats{RESET}"


def load_chats(project_cwd: str):
    files = []
    for path in SESSION_ROOT.rglob("rollout-*.jsonl"):
        meta = _parse_session_meta(path)
        if not meta or meta.get("cwd") != project_cwd:
            continue
        files.append(path)
    if not files:
        return []
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = pool.map(parse_one_chat, files)
    chats = [r for r in results if r is not None]
    return chats


def sort_chats(chats: list[dict], mode: str) -> list[dict]:
    return sorted(chats, key=lambda c: c.get("timestamp", "0"), reverse=True)


def fmt_chat_line(idx, chat, idx_width, summary=None, title=None):
    date = chat["date"] or ""
    size = chat["size"]
    msg = chat["message"]
    sid = (chat.get("session_id") or "")[:8]
    display_text = title or summary or msg
    if is_compact():
        max_msg = term_width() - idx_width - 21
        if not title and msg in ("(empty session)", "(resumed session)"):
            return f" {DIM}{idx:>{idx_width}} {sid} {size:>4s} {msg}{RESET}"
        if len(display_text) > max_msg:
            display_text = display_text[: max_msg - 1] + "~"
        if title or summary:
            display_text = f"{CYAN}{display_text}{RESET}"
        return f" {idx:>{idx_width}} {DIM}{sid}{RESET} {YELLOW}{size:>4s}{RESET} {display_text}"
    sid_col = f"{sid:<8s}"
    date_col = f"{date:<8s}"
    size_col = f"{size:<4s}"
    if not title and msg in ("(empty session)", "(resumed session)"):
        return f"  {DIM}{idx:>{idx_width}}  {sid_col}  {date_col}  {size_col}  {msg}{RESET}"
    display = f"{CYAN}{display_text}{RESET}" if (title or summary) else msg
    return f"  {idx:>{idx_width}}  {DIM}{sid_col}{RESET}  {DIM}{date_col}{RESET}  {YELLOW}{size_col}{RESET}  {display}"


# ── Preview ───────────────────────────────────────────────────────────────

TS_WIDTH = 12


def _preview_clean_text(text: str) -> str:
    text = XML_TAG_RE.sub("", text)
    text = ANSI_RE.sub("", text)
    text = re.sub(r"\n{3,}", "\n\n", text)
    return text.strip()


def _preview_extract_text(content) -> str:
    return _extract_text(content)


def _preview_is_system(content) -> bool:
    if isinstance(content, str):
        for tag in SYSTEM_TAGS:
            if tag in content:
                return True
    if isinstance(content, list):
        for part in content:
            if isinstance(part, dict):
                text = part.get("text", "") or part.get("content", "")
                for tag in SYSTEM_TAGS:
                    if tag in text:
                        return True
    return False


def _preview_fmt_timestamp(ts: str | None) -> str:
    if not ts:
        return " " * TS_WIDTH
    try:
        dt = datetime.fromisoformat(ts.replace("Z", "+00:00"))
        return dt.strftime("%b %d %H:%M")
    except (ValueError, TypeError):
        return " " * TS_WIDTH


def _preview_render_message(role: str, text: str, ts: str | None) -> str:
    out = []
    time_str = _preview_fmt_timestamp(ts)
    if role == "user":
        label = f"{GREEN}{BOLD}You   {RESET}"
    else:
        label = f"{MAGENTA}{BOLD}Codex {RESET}"
    out.append(f"  {label}  {DIM}{time_str}{RESET}")
    for line in text.split("\n"):
        out.append(f"    {line}")
    return "\n".join(out)


def _preview_read_messages(filepath):
    messages = []
    with open(filepath, "r", errors="replace") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            try:
                data = json.loads(line)
            except json.JSONDecodeError:
                continue
            if data.get("type") != "response_item":
                continue
            payload = data.get("payload", {})
            if payload.get("type") != "message":
                continue
            role = payload.get("role")
            if role not in ("user", "assistant"):
                continue
            raw = payload.get("content", [])
            if role == "user" and _preview_is_system(raw):
                continue
            content = _preview_clean_text(_preview_extract_text(raw))
            if content:
                messages.append((role, content, data.get("timestamp", "")))
    return messages


def preview_main(filepath: str):
    if not os.path.isfile(filepath):
        print(f"  {DIM}File not found{RESET}")
        return

    preview_cols = int(os.environ.get("FZF_PREVIEW_COLUMNS", 0))
    if not preview_cols:
        try:
            preview_cols = os.get_terminal_size().columns // 2
        except OSError:
            preview_cols = 40
    cols = max(preview_cols - 3, 20)
    sep = f"  {DIM}{CYAN}{'~' * cols}{RESET}"

    all_msgs = _preview_read_messages(filepath)

    if not all_msgs:
        print(f"\n  {DIM}(empty session){RESET}")
        return
    print(f"  {GREEN}-- start --{RESET}")
    for i, (role, text, ts) in enumerate(all_msgs):
        print(_preview_render_message(role, text, ts))
        if i < len(all_msgs) - 1:
            print(sep)
    print(f"  {RED}-- end --{RESET}")


