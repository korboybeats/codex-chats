def main():
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8", errors="replace")
        except Exception:
            pass

    if len(sys.argv) > 1 and sys.argv[1] == "--preview" and len(sys.argv) > 2:
        preview_main(sys.argv[2])
        return

    if len(sys.argv) > 1 and sys.argv[1] == "--set-key":
        key = prompt_gemini_key()
        if key:
            print(f"  {GREEN}Gemini API key configured.{RESET}")
        return

    if len(sys.argv) > 1 and sys.argv[1] in ("--help", "-h"):
        print_help()
        return

    if len(sys.argv) > 2 and sys.argv[1] in ("--resume", "-r"):
        fragment = sys.argv[2]
        matches = find_sessions_by_fragment(fragment)
        if not matches:
            print(f"No session found matching: {fragment}")
            sys.exit(1)
        if len(matches) > 1:
            print(f"Multiple sessions match '{fragment}':")
            for sid, _ in matches:
                print(f"  {sid}")
            sys.exit(1)
        resume_session(matches[0][0])
        return

    if not SESSION_ROOT.exists():
        print("No Codex sessions found.")
        return

    project_view()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(0)
