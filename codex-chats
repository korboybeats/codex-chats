def project_view():
    cfg = load_config()
    sort_mode = cfg.get("sort_mode", "recent")

    while True:
        projects = list_projects()
        if not projects:
            print("No Codex sessions found.")
            return

        projects = sort_projects(projects, sort_mode)
        total = sum(p[2] for p in projects)
        max_name_len = max((len(p[0]) for p in projects), default=10)

        lines = [fmt_project_line(p[0], p[2], max_name_len, p[4]) + f"\t{p[1]}" for p in projects]
        project_map = {p[1]: p for p in projects}

        cwd = os.getcwd()
        cwd_display = _display_path(cwd)
        sort_label = SORT_LABELS[sort_mode]
        cwd_line = f"  {CYAN}{cwd_display}{RESET}\n" if FZF_VER < 0.35 else ""

        unsafe = cfg.get("unsafe_mode", False)
        perms_indicator = f"{GREEN}perms{RESET}" if unsafe else f"{DIM}perms{RESET}"
        title_line = f"  {DIM}{total} chats, {len(projects)} projects{RESET}"
        if is_compact():
            parts = [
                f"{DIM}Enter{RESET} open",
                f"{DIM}^n{RESET} new",
                f"{DIM}^r{RESET} resume",
                f"{DIM}^f{RESET} folder",
                f"{DIM}^e{RESET} dir",
                f"{DIM}^d{RESET} del",
                f"{DIM}^x{RESET} purge empty",
                f"{DIM}^p{RESET} {perms_indicator}",
                f"{DIM}tab{RESET} {CYAN}{sort_label}{RESET}",
                f"{DIM}esc{RESET} quit",
            ]
        else:
            parts = [
                f"{DIM}Enter{RESET} open",
                f"{DIM}^n{RESET} new",
                f"{DIM}^r{RESET} resume ID",
                f"{DIM}^f{RESET} folder",
                f"{DIM}^e{RESET} explorer",
                f"{DIM}^d{RESET} del",
                f"{DIM}^x{RESET} purge empty",
                f"{DIM}^p{RESET} {perms_indicator}",
                f"{DIM}tab{RESET} {CYAN}{sort_label}{RESET}",
                f"{DIM}esc{RESET} quit",
            ]
        cmd_lines = _wrap_header(parts, term_width() - 2)
        header = title_line + "\n" + cwd_line + "\n".join(cmd_lines)

        key, sel = fzf(
            lines,
            header,
            prompt=" Projects > ",
            expect_keys=["tab", "ctrl-n", "ctrl-f", "ctrl-e", "ctrl-r", "ctrl-d", "ctrl-x", "ctrl-p"],
            border_label=cwd_display,
        )

        if key == "esc":
            return
        if key == "tab":
            next_idx = (SORT_MODES.index(sort_mode) + 1) % len(SORT_MODES)
            sort_mode = SORT_MODES[next_idx]
            cfg["sort_mode"] = sort_mode
            save_config(cfg)
            continue
        if key == "ctrl-p":
            cfg["unsafe_mode"] = not cfg.get("unsafe_mode")
            save_config(cfg)
            continue
        if key == "ctrl-f":
            clear_screen()
            print(f"\n  {BOLD}New project folder{RESET}")
            print(f"  {DIM}Enter path (~ allowed):{RESET} ", end="", flush=True)
            folder = input().strip()
            if not folder:
                continue
            folder = os.path.expanduser(folder)
            folder = os.path.abspath(folder)
            try:
                os.makedirs(folder, exist_ok=True)
            except OSError as e:
                print(f"\n  {RED}Error: {e}{RESET}")
                input(f"\n  {DIM}Press Enter...{RESET}")
                continue
            return new_session(folder)

        selection = sel[0] if sel else ""
        project_cwd = ""
        if selection and "\t" in selection:
            project_cwd = selection.split("\t", 1)[1]
        elif selection:
            stripped = strip_ansi(selection)
            m = re.match(r"^\s*(.+?)\s+\d+\s+chats\s*$", stripped)
            if m:
                name = m.group(1).strip()
                for cwd, entry in project_map.items():
                    if entry[0] == name:
                        project_cwd = cwd
                        break

        if key == "ctrl-n" and not project_cwd:
            return new_session(os.getcwd())
        if key == "ctrl-e" and project_cwd:
            open_folder(project_cwd)
            continue
        if key == "ctrl-r":
            clear_screen()
            print(f"\n  {BOLD}Resume by session ID{RESET}")
            print(f"  {DIM}Enter full or partial ID:{RESET} ", end="", flush=True)
            fragment = input().strip()
            if fragment:
                matches = find_sessions_by_fragment(fragment)
                if not matches:
                    print(f"\n  {RED}No session found matching: {fragment}{RESET}")
                    input(f"\n  {DIM}Press Enter...{RESET}")
                elif len(matches) > 1:
                    print(f"\n  {YELLOW}Multiple sessions match:{RESET}")
                    for sid, _ in matches:
                        print(f"    {sid}")
                    input(f"\n  {DIM}Press Enter...{RESET}")
                else:
                    resume_session(matches[0][0])
            continue
        if key == "ctrl-x":
            clear_screen()
            print(f"\n  {DIM}Scanning all projects...{RESET}", flush=True)
            empty_files = []
            for path in SESSION_ROOT.rglob("rollout-*.jsonl"):
                chat = parse_one_chat(path)
                if chat and chat["truly_empty"]:
                    empty_files.append(path)
            if not empty_files:
                clear_screen()
                print(f"\n  {DIM}No empty chats found{RESET}")
                input(f"\n  {DIM}Press Enter...{RESET}")
            else:
                clear_screen()
                print(f"\n  {YELLOW}Found {len(empty_files)} empty chat(s) across all projects.{RESET} Delete all?")
                answer = input(f"\n  {DIM}(y/N):{RESET} ").strip().lower()
                if answer == "y":
                    for fpath in empty_files:
                        try:
                            os.unlink(fpath)
                        except OSError:
                            pass
                    clear_screen()
                    print(f"\n  {GREEN}Purged {len(empty_files)} empty chat(s){RESET}")
                    input(f"\n  {DIM}Press Enter...{RESET}")
            continue

        if not project_cwd:
            continue

        display, real_cwd, count, _, _ = project_map[project_cwd]
        project_cwd = real_cwd

        if key == "ctrl-n":
            return new_session(project_cwd)
        if key == "ctrl-d":
            if count == 0:
                continue
            clear_screen()
            pname = _display_path(project_cwd)
            print(f"\n  {YELLOW}{pname}{RESET} has {count} chat(s). Delete all?")
            answer = input(f"\n  {DIM}(y/N):{RESET} ").strip().lower()
            if answer == "y":
                chats = load_chats(project_cwd)
                delete_chats(chats)
                clear_screen()
                print(f"\n  {GREEN}Deleted {count} chat(s).{RESET}")
                input(f"\n  {DIM}Press Enter...{RESET}")
            continue

        # Enter: open project
        if count == 0:
            return new_session(project_cwd)
        chat_view(project_cwd)


def chat_view(project_cwd: str, start_index: int | None = None):
    cfg = load_config()
    sort_mode = "recent"

    while True:
        chats = sort_chats(load_chats(project_cwd), sort_mode)
        if not chats:
            return

        idx_width = len(str(len(chats)))
        summaries_on = cfg.get("ai_summaries", False)
        summary_cache = load_summaries() if summaries_on else {}
        titles = load_titles()

        def build_chat_lines():
            lines = []
            for i, chat in enumerate(chats):
                sid = chat.get("session_id", "")
                s = summary_cache.get(sid) if summaries_on else None
                t = titles.get(sid)
                lines.append(fmt_chat_line(i + 1, chat, idx_width, summary=s, title=t) + f"\t{chat['file']}")
            return lines

        chat_lines = build_chat_lines()
        empty_indices = [i for i, c in enumerate(chats) if c["truly_empty"]]
        empty_hint = f" {DIM}({len(empty_indices)} empty){RESET}" if empty_indices else ""

        unsafe = cfg.get("unsafe_mode", False)
        perms_indicator = f"{GREEN}perms{RESET}" if unsafe else f"{DIM}perms{RESET}"
        title_line = f"  {BOLD}{_display_path(project_cwd)}{RESET}  {DIM}{len(chats)} chats{RESET}{empty_hint}"
        parts = [
            f"{DIM}Ent{RESET} resume",
            f"{DIM}^n{RESET} new",
            f"{DIM}^s{RESET} ai",
            f"{DIM}^r{RESET} rename",
            f"{DIM}^d{RESET} del",
            f"{DIM}^x{RESET} purge",
            f"{DIM}^p{RESET} {perms_indicator}",
            f"{DIM}bs{RESET} back",
        ]
        wrap_width = max(24, (term_width() // 2) - 4)
        cmd_lines = _wrap_header(parts, wrap_width)
        header = title_line + "\n" + "\n".join(cmd_lines)

        preview_cmd = f"{shlex.quote(sys.executable)} {shlex.quote(str(Path(__file__).resolve()))} --preview {{2}}"

        key, sel = fzf(
            chat_lines,
            header,
            multi=True,
            preview_cmd=preview_cmd,
            expect_keys=["bs", "ctrl-d", "ctrl-x", "ctrl-n", "ctrl-s", "ctrl-p", "ctrl-r"],
            border_label="Chats",
            start_index=start_index,
        )

        if key == "esc":
            return
        if key == "bs":
            return
        if key == "ctrl-n":
            return new_session(project_cwd)
        if key == "ctrl-s":
            summaries_on = not summaries_on
            cfg["ai_summaries"] = summaries_on
            save_config(cfg)
            if summaries_on:
                api_key = load_gemini_key()
                if not api_key:
                    api_key = prompt_gemini_key()
                if not api_key:
                    summaries_on = False
                    cfg["ai_summaries"] = False
                    save_config(cfg)
                    continue
                summary_cache = load_summaries()
                summary_cache = generate_missing_summaries(api_key, chats, summary_cache)
            continue
        if key == "ctrl-p":
            cfg["unsafe_mode"] = not cfg.get("unsafe_mode")
            save_config(cfg)
            continue
        if key == "ctrl-x":
            indices = empty_indices
            if not indices:
                continue
            confirm_delete(project_cwd, chats, indices)
            start_index = None
            continue

        if not sel:
            continue

        picked = []
        selected_index = None
        for s in sel:
            if "\t" in s:
                picked.append(s.split("\t", 1)[1])
                if selected_index is None:
                    m = re.match(r"^\s*(\d+)", strip_ansi(s))
                    if m:
                        selected_index = int(m.group(1))
            else:
                stripped = strip_ansi(s)
                line_map = {strip_ansi(line.split("\t", 1)[0]): line.split("\t", 1)[1] for line in chat_lines if "\t" in line}
                if stripped in line_map:
                    picked.append(line_map[stripped])
                    if selected_index is None:
                        m = re.match(r"^\s*(\d+)", stripped)
                        if m:
                            selected_index = int(m.group(1))

        picked_chats = [c for c in chats if c["file"] in picked]

        if key == "ctrl-r":
            if not picked_chats:
                continue
            chat = picked_chats[0]
            sid = chat.get("session_id", "")
            current_title = titles.get(sid, "")
            current_label = current_title or chat["message"]
            rename_header = (
                f"  {BOLD}Rename chat{RESET}  {DIM}(enter to save, esc to cancel){RESET}\n"
                f"  {DIM}Current:{RESET} {current_label}"
            )
            query, picked_line = fzf_rename(
                chat_lines,
                rename_header,
                preview_cmd=preview_cmd,
                border_label="Chats",
                start_index=selected_index or 1,
                initial_query="",
            )
            if query is None:
                continue
            new_title = query.strip()
            if picked_line and "\t" in picked_line:
                picked_path = picked_line.split("\t", 1)[1]
                for c in chats:
                    if c["file"] == picked_path:
                        sid = c.get("session_id", sid)
                        break
            if new_title:
                if len(new_title) > 120:
                    new_title = new_title[:117] + "..."
                titles[sid] = new_title
            else:
                titles.pop(sid, None)
            save_titles(titles)
            continue

        if key == "ctrl-d":
            indices = []
            for line in sel:
                clean = strip_ansi(line).strip()
                if clean:
                    m = re.match(r"^(\d+)", clean)
                    if m:
                        indices.append(int(m.group(1)) - 1)
        else:
            indices = []

        if key == "ctrl-d":
            if not indices:
                continue
            confirm_delete(project_cwd, chats, indices)
            start_index = selected_index
            continue

        # Enter => resume
        if picked_chats:
            resume_session(picked_chats[0]["session_id"])


def confirm_delete(project_cwd: str, chats: list[dict], indices: list[int]) -> None:
    clear_screen()
    try:
        cols = os.get_terminal_size().columns
    except OSError:
        cols = 80

    n = len(indices)
    label = f"conversation{'s' if n != 1 else ''}"
    total_size = 0
    for idx in indices:
        try:
            total_size += os.path.getsize(chats[idx]["file"])
        except OSError:
            pass
    if total_size < 1024:
        size_str = f"{total_size}B"
    elif total_size < 1024 * 1024:
        size_str = f"{total_size // 1024}KB"
    else:
        size_str = f"{total_size // (1024 * 1024)}MB"

    print()
    print(f"  {RED}{'~' * (cols - 4)}{RESET}")
    print()
    print(f"  {RED}{BOLD}  Delete {n} {label}{RESET}  {DIM}({size_str}){RESET}")
    print(f"  {DIM}  from {BOLD}{_display_path(project_cwd)}{RESET}")
    print()
    print(f"  {RED}{'~' * (cols - 4)}{RESET}")
    print()

    for idx in indices:
        chat = chats[idx]
        date = chat["date"] or "                "
        size = chat["size"]
        msg = chat["message"][:65]
        print(f"    {RED}x{RESET}  {DIM}{date:<16s}{RESET}  {YELLOW}{size:>4s}{RESET}  {msg}")

    print()
    print(f"  {RED}{'~' * (cols - 4)}{RESET}")
    print()
    answer = input(f"  {BOLD}Confirm delete? {RED}y{RESET}{DIM}/{RESET}{GREEN}N{RESET} ").strip().lower()

    if answer == "y":
        deleted = 0
        for idx in indices:
            chat = chats[idx]
            try:
                os.remove(chat["file"])
                deleted += 1
            except OSError as e:
                print(f"  {RED}Error: {e}{RESET}")
        print()
        print(f"  {GREEN}{BOLD}  Deleted {deleted} {label}.{RESET}")
        print()
        input(f"  {DIM}Press Enter...{RESET}")
    else:
        print(f"\n  {DIM}Cancelled.{RESET}")
        input(f"\n  {DIM}Press Enter...{RESET}")


