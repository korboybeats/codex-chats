def open_folder(path: str) -> None:
    try:
        if IS_WINDOWS:
            subprocess.Popen(["explorer", path])
        elif _is_wsl():
            win_path = subprocess.check_output(["wslpath", "-w", path], text=True).strip()
            subprocess.Popen(["explorer.exe", win_path])
        elif sys.platform == "darwin":
            subprocess.Popen(["open", path])
        else:
            subprocess.Popen(["xdg-open", path])
    except (FileNotFoundError, OSError):
        pass


def resume_session(session_id: str) -> None:
    cfg = load_config()
    cmd = _build_cmd(["codex", "resume", session_id], cfg)
    os.execvp(cmd[0], cmd)


def new_session(cwd: str | None) -> None:
    cfg = load_config()
    if cwd:
        cmd = _build_cmd(["codex", "-C", cwd], cfg)
        os.execvp(cmd[0], cmd)
    cmd = _build_cmd(["codex"], cfg)
    os.execvp(cmd[0], cmd)


def delete_chats(chats: list[dict]) -> int:
    deleted = 0
    for chat in chats:
        try:
            os.unlink(chat["file"])
            deleted += 1
        except OSError:
            pass
    return deleted


def purge_empty(chats: list[dict]) -> int:
    removed = 0
    for chat in chats:
        if chat["truly_empty"]:
            try:
                os.unlink(chat["file"])
                removed += 1
            except OSError:
                pass
    return removed


def find_sessions_by_fragment(fragment: str) -> list[tuple[str, str]]:
    matches = []
    frag = fragment.lower()
    for path in SESSION_ROOT.rglob("rollout-*.jsonl"):
        meta = _parse_session_meta(path)
        if not meta:
            continue
        sid = (meta.get("id") or "").lower()
        if sid == frag or sid.startswith(frag):
            matches.append((meta.get("id") or "", str(path)))
    return matches


